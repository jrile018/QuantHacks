# Copy to .env (the setup script does this) and paste your Massive API key. No spaces or quotes.
MASSIVE_API_KEY=your-key-here
# SEC EDGAR needs no key, only a real contact (name and email) in the User-Agent.
SEC_USER_AGENT=Your Name your@email.edu
# Optional: where SEC responses are cached. Default is %LOCALAPPDATA%\QuantHacks\sec_cache (keep it out of OneDrive).
# SEC_CACHE_DIR=
