# Copy to .env (the setup script does this) and paste your Massive API key. No spaces or quotes.
MASSIVE_API_KEY=your-key-here

CENSUS_API_KEY=
USASPENDING_API=None

# SEC EDGAR needs no key, only a real contact (name and email) in the User-Agent.
SEC_USER_AGENT=Your Name your@email.edu
# Optional: where SEC responses are cached. Default is %LOCALAPPDATA%\QuantHacks\sec_cache (keep it out of OneDrive).
# SEC_CACHE_DIR=

# TigerDB
Name=
PUBLIC_KEY=
SECRET_KEY=

# Optional for faster NVD CVE lookups in extract_epss.py; FIRST EPSS needs no key.
NVD_API_KEY=
# extract_company_metrics.py and extract_sec_filings.py use SEC_USER_AGENT above.
# Native SEC APIs require no SEC API key. No paid data-provider key is required.

# --- SAM.gov: UEI and entity registration (checklist sections 1 and 11) ---
# Free key from https://sam.gov/content/api-keys. Use this name, not SAM.GOV_KEY:
# a dot is not valid in a shell variable name. extract_sam_entities.py reads either.
SAM_GOV_API_KEY=

# --- Sources below are not built yet; each needs its own free key ---
# Patents and IP (section 13). PatentsView: https://patentsview.org/apis/keyrequest
PATENTSVIEW_API_KEY=
# USPTO Open Data Portal, an alternative patent source: https://developer.uspto.gov
USPTO_ODP_API_KEY=
# Lawsuits and dockets (section 10): https://www.courtlistener.com/help/api/rest/
COURTLISTENER_API_TOKEN=
# Federal legislation (section 12): https://api.data.gov/signup/
CONGRESS_GOV_API_KEY=
# Regulatory dockets and comments (section 12): https://open.gsa.gov/api/regulationsgov/
REGULATIONS_GOV_API_KEY=
# Interest rates and macro series (section 16): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Lobbying disclosures (section 11): https://lda.senate.gov/api/
SENATE_LDA_API_KEY=
# Job postings (section 17): https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# GitHub activity and releases (sections 7 and 17). Works unauthenticated but rate-limited.
GITHUB_TOKEN=
